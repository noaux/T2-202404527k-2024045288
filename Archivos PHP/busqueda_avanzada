<?php
session_start();

// Validar seguridad: Solo el Administrador (Rol 3) puede entrar aquí
if (!isset($_SESSION['id_rol']) || $_SESSION['id_rol'] != 3) {
    header("Location: index.php");
    exit();
}

require 'conexion.php';

// 1. Obtener datos para llenar las listas desplegables (combobox)
$regiones = $conn->query("SELECT DISTINCT region FROM centro_medico ORDER BY region ASC");
$centros = $conn->query("SELECT codigo_interno, nombre FROM centro_medico");
$especialidades = $conn->query("SELECT id_especialidad, nom_especialidad FROM especialidad");
$medicos = $conn->query("SELECT rut_medico, nom_completo FROM medico");
$estados = $conn->query("SELECT id_estado, nom_estado FROM estado_cita");
$previsiones = $conn->query("SELECT nom_prevision FROM prevision");

// 2. Construir la consulta dinámica basada en los filtros ingresados
$sql = "SELECT * FROM vista_resumen_citas WHERE 1=1";

// Filtro de Región
if (!empty($_GET['region'])) {
    $region = $conn->real_escape_string($_GET['region']);
    $sql .= " AND region = '$region'";
}

// Filtro de Centro Médico
if (!empty($_GET['centro'])) {
    $centro = $conn->real_escape_string($_GET['centro']);
    $sql .= " AND cod_centro = '$centro'";
}

// Filtro de Especialidad
if (!empty($_GET['especialidad'])) {
    $esp = (int)$_GET['especialidad'];
    $sql .= " AND id_especialidad = $esp";
}

// Filtro de Médico
if (!empty($_GET['medico'])) {
    $med = $conn->real_escape_string($_GET['medico']);
    $sql .= " AND rut_medico = '$med'";
}

// Filtro de Estado de Cita
if (!empty($_GET['estado'])) {
    $est = (int)$_GET['estado'];
    $sql .= " AND id_estado = $est";
}

// Filtro de Previsión
if (!empty($_GET['prevision'])) {
    $prev = $conn->real_escape_string($_GET['prevision']);
    $sql .= " AND prevision = '$prev'";
}

// Rango de Fechas
if (!empty($_GET['fecha_inicio'])) {
    $fecha_ini = $conn->real_escape_string($_GET['fecha_inicio']);
    $sql .= " AND DATE(fecha_hora) >= '$fecha_ini'";
}
if (!empty($_GET['fecha_fin'])) {
    $fecha_fin = $conn->real_escape_string($_GET['fecha_fin']);
    $sql .= " AND DATE(fecha_hora) <= '$fecha_fin'";
}

$sql .= " ORDER BY fecha_hora DESC";
$resultados = $conn->query($sql);
?>

